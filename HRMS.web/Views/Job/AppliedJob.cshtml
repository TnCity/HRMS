@model IEnumerable<HRMS.Entities.Application>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@{
    ViewData["Title"] = "Applied Jobs";

    var total = Model.Count();

    var selected =
        Model.Count(x => x.Status == "Selected");

    var rejected =
        Model.Count(x => x.Status == "Rejected");

    var applied =
        Model.Count(x => x.Status == "Applied");
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="text-center mb-5">

        <h2 class="fw-bold text-primary">
            Recruitment Dashboard
        </h2>

        <p class="text-secondary mb-0">
            Manage candidate applications and interview process
        </p>

    </div>

    <!-- SUMMARY CARDS -->

    <div class="row g-4 mb-4">

        <!-- TOTAL -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background: #eef4ff;">

                <div class="card-body">

                    <h6 class="text-secondary text-uppercase mb-3">
                        Total Applications
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @total
                    </h2>

                </div>

            </div>

        </div>

        <!-- SELECTED -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background: #eefbf3;">

                <div class="card-body">

                    <h6 class="text-secondary text-uppercase mb-3">
                        Selected
                    </h6>

                    <h2 class="fw-bold text-success">
                        @selected
                    </h2>

                </div>

            </div>

        </div>

        <!-- REJECTED -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background: #fff1f2;">

                <div class="card-body">

                    <h6 class="text-secondary text-uppercase mb-3">
                        Rejected
                    </h6>

                    <h2 class="fw-bold text-danger">
                        @rejected
                    </h2>

                </div>

            </div>

        </div>

        <!-- PENDING -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background: #fff8e8;">

                <div class="card-body">

                    <h6 class="text-secondary text-uppercase mb-3">
                        Review Pending
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @applied
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- APPLICATION TABLE -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- CARD HEADER -->

        <div class="card-header border-0 py-3"
             style="background:#f4f7fb;">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold text-dark">
                    Candidate Applications
                </h5>

                <span class="badge bg-primary px-3 py-2">
                    @total Records
                </span>

            </div>

        </div>

        <!-- TABLE -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead style="background:#f8fafc;">

                        <tr>
                            <th>Candidate Id</th>

                            <th class="ps-4">
                                Candidate
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Job Role
                            </th>

                            <th>
                                CV ShortListing Status
                            </th>

                            

                            <th>
                               Apply Date
                            </th>

                            <th class="text-center">
                                Resume/CV
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                            <th>
                                Final Result
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Candidate -->
                                    <td>
                                        @item.Candidate.CandidateId
                                    </td>
                                    <td class="ps-4">

                                        <span class="fw-semibold text-dark">
                                            @item.Candidate.FullName
                                        </span>

                                    </td>

                                    <!-- Email -->

                                    <td class="text-secondary">
                                        @item.Candidate.Email
                                    </td>

                                    <!-- Phone -->

                                    <td class="text-secondary">
                                        @item.Candidate.Phone
                                    </td>

                                    <!-- Job Role -->

                                    <td>

                                        <span class="fw-semibold text-dark">
                                            @item.Job.Title
                                        </span>

                                    </td>

                                    <!-- STATUS -->

                                    <td>

                                        @if (item.Status == "Applied")
                                        {
                                            <span class="text-primary fw-semibold">

                                                Pending

                                            </span>
                                        }
                                        else if (item.Status == "Selected")
                                        {
                                            <span class="text-success fw-semibold">

                                                Selected

                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-danger fw-semibold">

                                                Rejected

                                            </span>
                                        }

                                    </td>

                                    

                                    <!-- DATE -->

                                    <td class="text-secondary">

                                        @item.AppliedDate.ToString("dd MMM yyyy")

                                    </td>

                                    <!-- RESUME -->

                                    <td class="text-center">

                                        @if (!string.IsNullOrEmpty(item.Candidate.ResumePath))
                                        {
                                            <a href="@item.Candidate.ResumePath"
                                                   target="_blank"
                                                   class="btn btn-outline-info btn-sm rounded-pill px-3 me-2">

                                                View

                                            </a>

                                            <a href="@item.Candidate.ResumePath"
                                                   download
                                                   class="btn btn-outline-success btn-sm rounded-pill px-3">

                                                Download

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                No Resume

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTION -->

                                    <td class="text-center">

                                        @if (item.Status == "Applied")
                                        {
                                            <a asp-action="ApplicationStatus"
                                                   asp-route-id="@item.ApplicationId"
                                                   asp-route-status="Selected"
                                                   class="btn btn-success btn-sm rounded-pill px-3 me-2">

                                                Select

                                            </a>

                                            <a asp-action="ApplicationStatus"
                                                   asp-route-id="@item.ApplicationId"
                                                   asp-route-status="Rejected"
                                                   class="btn btn-danger btn-sm rounded-pill px-3">

                                                Reject

                                            </a>
                                        }
                                        else if (item.Status == "Selected")
                                        {
                                            <a asp-controller="Interview"
                                                   asp-action="Create"
                                                   asp-route-applicationId="@item.ApplicationId"
                                                   class="btn btn-primary btn-sm rounded-pill px-3">

                                                Schedule Interview

                                            </a>
                                        }

                                    </td>
                                    <!-- FINAL RESULT -->

                                    <td>

                                        @if (item.Status == "Selected")
                                        {
                                            <span class="text-success fw-semibold">

                                                Selected

                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-danger fw-semibold">

                                                Rejected

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary fw-semibold">

                                                Pending

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <h5 class="text-muted">

                                        No Applications Found

                                    </h5>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
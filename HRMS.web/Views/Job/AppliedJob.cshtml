@model IEnumerable<HRMS.Entities.Application>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            Applied Jobs
        </h2>

        <span class="badge bg-dark fs-6">
            Total Applications : @Model.Count()
        </span>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Candidate</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Job</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th class="text-center">Resume</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="ps-4 fw-semibold">
                                    @item.Candidate.FullName
                                </td>

                                <td>
                                    @item.Candidate.Email
                                </td>

                                <td>
                                    @item.Candidate.Phone
                                </td>

                                <td>
                                    <span class="fw-semibold text-dark">
                                        @item.Job.Title
                                    </span>
                                </td>

                                <td>
                                    @if (item.Status == "Applied")
                                    {
                                        <span class="badge bg-primary px-3 py-2">
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Shortlisted")
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.AppliedDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-center">

                                    @if (!string.IsNullOrEmpty(item.Candidate.ResumePath))
                                    {
                                        <a href="@item.Candidate.ResumePath"
                                               target="_blank"
                                               class="btn btn-sm btn-info me-2">
                                            <i class="bi bi-eye-fill"></i>
                                            View
                                        </a>

                                        <a href="@item.Candidate.ResumePath"
                                               download
                                               class="btn btn-sm btn-success">
                                            <i class="bi bi-download"></i>
                                            Download
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Resume
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">

                                <h5 class="text-muted">
                                    No Applications Found
                                </h5>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
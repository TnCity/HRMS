




@model IEnumerable<HRMS.Entities.Job>

@{
    ViewData["Title"] = "Available Jobs";

    bool isAdmin = Context.Session.GetString("Role")?.Trim().ToLower() == "admin";
}

<div class="position-relative mb-4">

    <div class="text-center">
        <h2 class="fw-bold text-primary">Available Jobs</h2>
        <p class="text-secondary">Manage and monitor all available job openings</p>
    </div>

    @if (isAdmin)
    {
        <div class="position-absolute top-0 end-0">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Add Job
            </a>
        </div>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-semibold">Job Listings</h5>

        <span class="badge bg-primary px-3 py-2">
            @Model.Count() Jobs
        </span>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Job ID</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Experience</th>
                        <th>Location</th>
                        <th>Salary</th>
                        <th>Last Date</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="ps-4 fw-semibold text-muted">
                                    #@item.JobId
                                </td>

                                <td class="fw-semibold">
                                    @item.Title
                                </td>

                                <td>@item.Department</td>

                                <td>@item.ExperienceRequired</td>

                                <td>@item.Location</td>

                                <td class="fw-semibold text-success">
                                    @item.SalaryRange
                                </td>

                                <td>
                                    @item.LastDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge @(item.Status == "Open"
                                                                                                                          ? "bg-success-subtle text-success"
                                                                                                                          : "bg-danger-subtle text-danger") px-3 py-2 rounded-pill">

                                        @item.Status
                                    </span>
                                </td>

                                <td class="text-center">

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <a asp-action="Details"
                                               asp-route-id="@item.JobId"
                                               class="btn btn-outline-info btn-sm rounded-pill px-3">
                                            View
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit"
                                                   asp-route-id="@item.JobId"
                                                   class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@item.JobId"
                                                   class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                   onclick="return confirm('Delete this job?');">
                                                Delete
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                No Jobs Available
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div> 
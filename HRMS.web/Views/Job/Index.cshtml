


@model IEnumerable<HRMS.Entities.Job>

@{
    ViewData["Title"] = "Available Jobs";

    var role = Context.Session.GetString("Role");

    bool isAdmin = !string.IsNullOrEmpty(role) &&
        role.Trim().ToLower() == "admin";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
         
        <h3>Available Job</h3>

        @if (isAdmin)
        {
            <a asp-action="Create"
                   class="btn btn-primary">
                Add Job
            </a>
        }

    </div>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>JobId</th>
                <th>Title</th>
                <th>Department</th>
                <th>Location</th>
                <th>Salary</th>
                <th>Last Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.JobId</td>
                    <td>@item.Title</td>
                    <td>@item.Department</td>
                    <td>@item.Location</td>
                    <td>@item.SalaryRange</td>
                    <td>@item.LastDate.ToShortDateString()</td>
                    <td>@item.Status</td>

                    <td class="text-center">

                        <div class="d-flex justify-content-center gap-1">

                            <a asp-action="Details"
                                   asp-route-id="@item.JobId"
                                   class="btn btn-sm btn-info">
                                View
                            </a>

                            @if (isAdmin)
                            {
                                <a asp-action="Edit"
                                       asp-route-id="@item.JobId"
                                       class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.JobId"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Are you sure you want to delete this job?');">
                                    Delete
                                </a>
                            }

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
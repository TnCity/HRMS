


                            @model IEnumerable<HRMS.Entities.Job>

@{
    ViewData["Title"] = "Available Jobs";

    var role = Context.Session.GetString("Role");

    bool isAdmin = !string.IsNullOrEmpty(role) &&
        role.Trim().ToLower() == "admin";
}

<div class="position-relative mb-4">

    <!-- CENTER TITLE -->

    <div class="text-center">

        <h2 class="fw-bold text-primary mb-1">
            Available Jobs
        </h2>

        <p class="text-secondary mb-0">
            Manage and monitor all available job openings
        </p>

    </div>

    <!-- RIGHT BUTTON -->

    @if (isAdmin)
    {
        <div class="position-absolute top-0 end-0">

            <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4 shadow-sm">

                <i class="bi bi-plus-circle me-2"></i>
                Add Job

            </a>

        </div>
    }

</div>
    <!-- JOB TABLE CARD -->

    <div class="card border-0 shadow-sm rounded-4 bg-white">

        <!-- CARD HEADER -->

        <div class="card-header bg-light border-0 py-3 rounded-top-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold text-dark">
                    Job Listings
                </h5>

                <span class="badge bg-primary px-3 py-2">
                    @Model.Count() Jobs
                </span>

            </div>

        </div>

        <!-- TABLE -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle table-hover mb-0">

                    <thead class="bg-light">

                        <tr>

                            <th class="ps-4 text-secondary fw-semibold">
                                Job ID
                            </th>

                            <th class="text-secondary fw-semibold">
                                Title
                            </th>

                            <th class="text-secondary fw-semibold">
                                Department
                            </th>

                            <th class="text-secondary fw-semibold">
                                Experience
                            </th>

                            <th class="text-secondary fw-semibold">
                                Location
                            </th>

                            <th class="text-secondary fw-semibold">
                                Salary
                            </th>

                            <th class="text-secondary fw-semibold">
                                Last Date
                            </th>

                            <th class="text-secondary fw-semibold">
                                Status
                            </th>

                            <th class="text-center text-secondary fw-semibold">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- JOB ID -->

                                    <td class="ps-4 fw-semibold text-muted">
                                        #@item.JobId
                                    </td>

                                    <!-- TITLE -->

                                    <td>

                                        <div class="fw-semibold text-dark">
                                            @item.Title
                                        </div>

                                    </td>

                                    <!-- DEPARTMENT -->

                                    <td class="text-secondary">
                                        @item.Department
                                    </td>

                                    <!-- EXPERIENCE -->

                                    <td class="text-secondary">
                                        @item.ExperienceRequired
                                    </td>

                                    <!-- LOCATION -->

                                    <td class="text-secondary">
                                        @item.Location
                                    </td>

                                    <!-- SALARY -->

                                    <td class="fw-semibold text-success">
                                        @item.SalaryRange
                                    </td>

                                    <!-- LAST DATE -->

                                    <td class="text-secondary">
                                        @item.LastDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- STATUS -->

                                    <td>

                                        @if (item.Status == "Open")
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">

                                                Open

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">

                                                Closed

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTION -->

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <!-- VIEW -->

                                            <a asp-action="Details"
                                               asp-route-id="@item.JobId"
                                               class="btn btn-outline-info btn-sm rounded-pill px-3">

                                                View

                                            </a>

                                            @if (isAdmin)
                                            {
                                                <!-- EDIT -->

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.JobId"
                                                   class="btn btn-outline-primary btn-sm rounded-pill px-3">

                                                    Edit

                                                </a>

                                                <!-- DELETE -->

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.JobId"
                                                   class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                   onclick="return confirm('Are you sure you want to delete this job?');">

                                                    Delete

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9" class="text-center py-5">

                                    <h5 class="text-muted">

                                        No Jobs Available

                                    </h5>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
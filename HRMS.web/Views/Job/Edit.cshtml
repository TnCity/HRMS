@model HRMS.Entities.Job

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Job";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-light text-dark rounded-top-4 py-3">

                    <div class="position-relative text-center">

                        <h3 class="mb-0 fw-bold">
                             Edit Job Details
                        </h3>

                        <span class="badge bg-dark fs-6 position-absolute top-50 end-0 translate-middle-y">
                            Job ID: @Model.JobId
                        </span>

                    </div>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="JobId" />

                        

                        <!-- JOB TITLE -->

                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                                Job Title
                            </label>

                            <input asp-for="Title"
                                    class="form-control form-control-lg"
                                    placeholder="Enter job title" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- DEPARTMENT -->

                        <div class="mb-4">

                            <label asp-for="Department"
                                   class="form-label fw-semibold">
                                Department
                            </label>

                            <input asp-for="Department"
                                   class="form-control form-control-lg"
                                   placeholder="Enter department" />

                            <span asp-validation-for="Department"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Job Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter job description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- EXPERIENCE -->

                        <div class="mb-4">

                            <label asp-for="ExperienceRequired"
                                   class="form-label fw-semibold">
                                Experience Required
                            </label>

                            <input asp-for="ExperienceRequired"
                                   class="form-control form-control-lg"
                                   placeholder="Example: 2+ Years" />

                            <span asp-validation-for="ExperienceRequired"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- SALARY -->

                        <div class="mb-4">

                            <label asp-for="SalaryRange"
                                   class="form-label fw-semibold">
                                Salary Range
                            </label>

                            <input asp-for="SalaryRange"
                                   class="form-control form-control-lg"
                                   placeholder="Example: 5 LPA - 8 LPA" />

                            <span asp-validation-for="SalaryRange"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- LOCATION -->

                        <div class="mb-4">

                            <label asp-for="Location"
                                   class="form-label fw-semibold">
                                Location
                            </label>

                            <input asp-for="Location"
                                   class="form-control form-control-lg"
                                   placeholder="Enter location" />

                            <span asp-validation-for="Location"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- LAST DATE -->

                        <div class="mb-4">

                            <label asp-for="LastDate"
                                   class="form-label fw-semibold">
                                Last Apply Date
                            </label>

                            <input asp-for="LastDate"
                                   type="date"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="LastDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- STATUS -->

                        <div class="mb-4">

                            <label asp-for="Status"
                                   class="form-label fw-semibold">
                                Status
                            </label>

                            <select asp-for="Status"
                                    class="form-select form-select-lg">

                                <option value="Open">
                                    Open
                                </option>

                                <option value="Closed">
                                    Closed
                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- BUTTONS -->

                        <div class="d-flex gap-3 mt-4">

                            <button type="submit"
                                    class="btn btn-success btn-lg px-4">

                                Update Job

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary btn-lg px-4">

                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
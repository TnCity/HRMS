@model IEnumerable<HRMS.Entities.Interview>

<div class="container mt-4">

    <div class="card border-0 shadow-sm rounded-4">

        <!-- HEADER -->

        <div class="card-header bg-primary text-white rounded-top-4 py-3">

            <div class="position-relative text-center">

                <h4 class="fw-bold mb-0">
                    Interview Status
                </h4>

                <span class="badge bg-light text-dark
                    position-absolute top-50 end-0 translate-middle-y px-3 py-2">

                    @Model.Count() Records

                </span>

            </div>

        </div>

        <!-- TABLE -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>ID</th>
                            <th>Candidate</th>
                            <th>Job Role</th>
                            <th>Date</th>
                            <th>Interview Type</th>
                            <th>Final Status</th>
                            <th class="text-center">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Candidate ID -->

                                <td class="fw-semibold text-dark">
                                    #@item.Application.Candidate.CandidateId
                                </td>

                                <!-- Candidate Name -->

                                <td>
                                    @item.Application.Candidate.FullName
                                </td>

                                <!-- Job -->

                                <td>
                                    @item.Application.Job.Title
                                </td>

                                <!-- Date -->

                                <td>
                                    @item.InterviewDate.ToString("dd MMM yyyy")
                                </td>

                                <!-- Interview Type -->

                                <td>
                                    @item.InterviewType
                                </td>

                                <!-- FINAL RESULT -->

                                <td>

                                    @if (item.Application.FinalResult == "Selected")
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            Selected
                                        </span>
                                    }
                                    else if (item.Application.FinalResult == "Rejected")
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <!-- ACTION -->

                                <td class="text-center">

                                    @if (string.IsNullOrEmpty(item.Application.FinalResult))
                                    {
                                        <a asp-action="InterviewResult"
                                               asp-route-id="@item.InterviewId"
                                               class="btn btn-primary btn-sm rounded-pill px-3">

                                            Add Decision

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">

                                            Submitted

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<HRMS.Entities.InterviewResult>

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white py-3">

            <h3 class="mb-0">
                Interview Status
            </h3>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Candidate</th>

                            <th>Job Role</th>

                            <th>Interview Date</th>

                            <th>Interview Type</th>

                            <th>Feedback</th>

                            <th>Result</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Interview.Application.Candidate.FullName
                                </td>

                                <td>
                                    @item.Interview.Application.Job.Title
                                </td>

                                <td>
                                    @(item.Interview.InterviewDate.ToString("dd MMM yyyy"))
                                </td>

                                <td>
                                    @item.Interview.InterviewType
                                </td>

                                <td>
                                    @item.Feedback
                                </td>

                                <td>

                                    @if (item.Result == "Selected")
                                    {
                                        <span class="badge bg-success">

                                            Selected

                                        </span>
                                    }
                                    else if (item.Result == "Rejected")
                                    {
                                        <span class="badge bg-danger">

                                            Rejected

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">

                                            On Hold

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
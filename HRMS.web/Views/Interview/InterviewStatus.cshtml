


@model IEnumerable<HRMS.Entities.Interview>

<div class="container mt-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-primary text-white">

            <div class="position-relative text-center">

                <h4 class="mb-0">
                    Interview Status
                </h4>

                <span class="badge bg-light text-dark
                    position-absolute top-50 end-0 translate-middle-y">

                    @Model.Count() Records

                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>ID</th>
                            <th>Candidate</th>
                            <th>Job Role</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    #@item.Application.Candidate.CandidateId
                                </td>

                                <td>
                                    @item.Application.Candidate.FullName
                                </td>

                                <td>
                                    @item.Application.Job.Title
                                </td>

                                <td>
                                    @item.InterviewDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.InterviewType
                                </td>

                                <td>

                                    @if (item.InterviewResult == null)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (item.InterviewResult.Result == "Selected")
                                    {
                                        <span class="badge bg-success">
                                            Selected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.InterviewResult == null)
                                    {
                                        <a asp-action="InterviewResult"
                                               asp-route-id="@item.InterviewId"
                                               class="btn btn-primary btn-sm">

                                            Add Decision

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">
                                            Submitted
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@*
  ======================================  Apply Multi Language==========================================
*@


@using Microsoft.Extensions.Localization
@using HRMS.web
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ContactUs"];
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="text-center mb-5">

        <h2 class="fw-bold text-primary">
            @Localizer["ContactUs"]
        </h2>

        <p class="text-muted">
            @Localizer["ContactSubtitle"]
        </p>

    </div>

    <div class="row">

        <!-- CONTACT FORM -->
        <div class="col-md-6">

            <div class="card p-4 shadow-sm">

                <h5 class="mb-3">
                    @Localizer["SendMessage"]
                </h5>

                <form method="post" asp-action="Contact">

                    <div class="mb-3">

                        <label>
                            @Localizer["Name"] *
                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label>
                            @Localizer["Email"] *
                        </label>

                        <input type="email"
                               name="Email"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label>
                            @Localizer["Message"] *
                        </label>

                        <textarea name="Message"
                              class="form-control"
                              rows="4"
                                  required>
                        </textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">

                        @Localizer["SendMessage"]

                    </button>

                </form>

            </div>

        </div>

        <!-- CONTACT INFO -->
        <div class="col-md-6">

            <div class="card p-4 shadow-sm h-100">

                <h5 class="mb-3">
                    @Localizer["ContactInformation"]
                </h5>

                <p>
                    <strong>
                        📍 @Localizer["Address"]:
                    </strong>

                    Kolkata, India
                </p>

                <p>
                    <strong>
                        📞 @Localizer["Phone"]:
                    </strong>

                    +91 1234567890
                </p>

                <p>
                    <strong>
                        📧 @Localizer["Email"]:
                    </strong>

                    support@hrms.com
                </p>

                <hr />

                <h6>
                    @Localizer["WorkingHours"]
                </h6>

                <p class="mb-0">
                    @Localizer["Monday"] - @Localizer["Friday"]: 9:00 AM - 6:00 PM
                </p>

            </div>

        </div>

    </div>

    <!-- MAP -->
    <div class="mt-5">

        <iframe src="https://maps.google.com/maps?q=kolkata&t=&z=13&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="300"
                style="border:0;"
                allowfullscreen>
        </iframe>

    </div>

</div>